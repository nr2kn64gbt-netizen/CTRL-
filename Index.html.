<!doctype html>
<html lang="en" dir="ltr">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#071d3c">
<meta name="description" content="CTRL is an emerging independent youth initiative. A space for ideas, conversations and new perspectives is taking shape.">
<title>CTRL — Under CTRLstruction</title>
<style>
:root{--navy:#071d3c;--teal:#55b3b0;--pink:#d21f68;--purple:#8b70bd;--paper:#f7f8fa;--muted:#b8c3d2}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--navy);color:white;font-family:Arial,Helvetica,sans-serif}
.wrap{width:min(1160px,90%);margin:auto}a{color:inherit;text-decoration:none}
header{height:88px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #ffffff25}
.brand img{width:94px;height:65px;object-fit:contain;object-position:left center}
nav{display:flex;gap:30px;font-size:11px;letter-spacing:1.5px;text-transform:uppercase;color:#d9e1eb}
nav a:hover{color:var(--teal)}.menu{display:none;background:none;border:0;color:white;font-size:25px}.header-tools{display:flex;align-items:center;gap:22px}.lang{border:1px solid #ffffff55;background:transparent;color:white;padding:9px 13px;font-size:11px;letter-spacing:1px;cursor:pointer}.lang:hover{border-color:var(--teal);color:var(--teal)}
.hero{min-height:680px;display:grid;grid-template-columns:1.05fr .95fr;align-items:center;gap:40px;padding:65px 0 85px}
.eyebrow{font-size:11px;letter-spacing:3px;text-transform:uppercase;color:var(--teal);display:flex;gap:12px;align-items:center}
.eyebrow:before{content:"";height:2px;width:28px;background:var(--teal)}
h1{font-size:clamp(58px,8vw,108px);line-height:.88;letter-spacing:-.08em;margin:25px 0;font-weight:950;text-transform:uppercase}
h1 .accent{color:var(--pink);display:block}.intro{max-width:490px;color:#d2dbe7;font-size:17px;line-height:1.8}
.actions{display:flex;gap:14px;align-items:center;margin-top:32px;flex-wrap:wrap}
.btn{padding:15px 21px;background:var(--pink);font-size:11px;font-weight:800;letter-spacing:1.5px;text-transform:uppercase;transition:.2s}
.btn:hover{background:var(--purple);transform:translateY(-3px)}
.visual{height:455px;position:relative;display:grid;place-items:center;background:radial-gradient(circle at 50% 50%,#23416a 0,#102b50 42%,#071d3c 75%);overflow:hidden}
.visual:before,.visual:after{content:"";position:absolute;border:1px solid #ffffff35;border-radius:50%;width:370px;height:370px;transform:rotate(-25deg) scaleY(.55)}
.visual:after{width:285px;height:285px;transform:rotate(35deg) scaleY(.55);border-color:#55b3b080}
.logo-large{width:min(76%,390px);filter:drop-shadow(0 18px 35px #0007);z-index:1}
.visual-note{position:absolute;bottom:22px;right:22px;font-size:10px;letter-spacing:2px;color:#d8e3ee}
section{padding:100px 0;border-top:1px solid #ffffff25}
.kicker{color:var(--teal);font-size:11px;letter-spacing:3px;text-transform:uppercase}
h2{font-size:clamp(38px,6vw,70px);line-height:.95;letter-spacing:-.07em;margin:14px 0;text-transform:uppercase}
.section-head{display:flex;justify-content:space-between;align-items:end;gap:35px;margin-bottom:42px}
.note{max-width:390px;color:var(--muted);font-size:14px;line-height:1.8}
.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
.tile{padding:30px;min-height:235px;border:1px solid #ffffff30;background:#0d294b;transition:.25s}
.tile:hover{transform:translateY(-5px);border-color:var(--teal)}
.tile .n{font-size:11px;letter-spacing:2px;color:var(--pink)}
.tile h3{font-size:24px;margin:34px 0 12px;letter-spacing:-1px}
.tile p{font-size:13px;color:var(--muted);line-height:1.75;margin:0}
.statement{background:var(--teal);color:var(--navy);padding:65px 8%;margin:0}
.statement p{font-size:clamp(30px,5vw,59px);font-weight:950;line-height:1;letter-spacing:-.06em;text-transform:uppercase;margin:0;max-width:900px}
.statement small{display:block;margin-top:24px;letter-spacing:2px;font-size:10px}
.phase{display:grid;grid-template-columns:1fr 1fr;gap:45px;align-items:center}
.phase-box{padding:34px;border:1px solid #ffffff35;background:#0d294b}
.phase-box strong{display:block;font-size:12px;letter-spacing:2px;color:var(--pink);margin-bottom:15px}
.phase-box p{color:#d2dbe7;line-height:1.8;margin:0;font-size:14px}
footer{padding:28px 0;color:#aab8c9;font-size:10px;letter-spacing:1.5px;display:flex;justify-content:space-between;gap:20px}
html[dir="rtl"] body{font-family:Tahoma,Arial,sans-serif}html[dir="rtl"] nav{letter-spacing:0}html[dir="rtl"] .eyebrow,html[dir="rtl"] .kicker,html[dir="rtl"] .visual-note,html[dir="rtl"] .phase-box strong,html[dir="rtl"] footer{letter-spacing:0}html[dir="rtl"] .eyebrow:before{display:none}html[dir="rtl"] .section-head{direction:rtl}html[dir="rtl"] .statement p{letter-spacing:0}html[dir="rtl"] .statement small{letter-spacing:0}html[dir="rtl"] .tile h3{letter-spacing:0}html[dir="rtl"] .visual-note{right:auto;left:22px}
@media(max-width:760px){header{height:72px}.brand img{width:80px;height:58px}nav{display:none;position:absolute;top:72px;left:0;right:0;background:#0d294b;padding:24px 5%;flex-direction:column;z-index:5}.menu{display:block}.hero{grid-template-columns:1fr;padding:50px 0;min-height:auto}.visual{height:300px;grid-row:1}.hero-copy{grid-row:2}.section-head{display:block}.note{margin-top:20px}.grid,.phase{grid-template-columns:1fr}.tile{min-height:190px}footer{flex-direction:column}}
</style>
</head>
<body>
<header class="wrap">
<a class="brand" href="#home" aria-label="CTRL home"><img src="data:image/png;base64," alt="CTRL logo"></a>
<div class="header-tools"><nav id="nav"><a href="#about" data-en="About" data-ar="من نحن">About</a><a href="#vision" data-en="Our direction" data-ar="توجّهنا">Our direction</a><a href="#journey" data-en="The journey" data-ar="رحلتنا">The journey</a></nav><button class="lang" id="langToggle" type="button" aria-label="Switch language">العربية</button></div>
<button class="menu" aria-label="Toggle navigation" onclick="const n=document.getElementById('nav');n.style.display=n.style.display==='flex'?'none':'flex'">☰</button>
</header>
<main id="home">
<div class="wrap hero">
<div class="hero-copy">
<div class="eyebrow" data-en="An independent youth initiative" data-ar="مبادرة شبابية مستقلة">An independent youth initiative</div>
<h1 data-en="A new space|is taking shape." data-ar="مساحة جديدة|تأخذ شكلها.">A new space<br>is taking <span class="accent">shape.</span></h1>
<p class="intro" data-en="A space for young people to explore ideas, exchange perspectives and engage with the topics shaping our time — in ways that feel different." data-ar="مساحة للشباب لاستكشاف الأفكار، وتبادل وجهات النظر، والتفاعل مع مواضيع عصرنا بأساليب مختلفة وخارجة عن المألوف.">A space for young people to explore ideas, exchange perspectives and engage with the topics shaping our time — in ways that feel different.</p>
<div class="actions"><a class="btn" href="#about" data-en="Get to know CTRL ↗" data-ar="اكتشف CTRL ↗">Get to know CTRL ↗</a></div>
</div>
<div class="visual"><img class="logo-large" src="data:image/png;base64," alt="CTRL"><div class="visual-note" data-en="UNDER CTRLSTRUCTION" data-ar="قيد التشكّل">UNDER CTRLSTRUCTION</div></div>
</div>

<section id="about"><div class="wrap">
<div class="section-head"><div><div class="kicker" data-en="01 / About CTRL" data-ar="01 / من نحن">01 / About CTRL</div><h2 data-en="Not just another|student activity." data-ar="مش مجرد|نشاط طلابي.">Not just another<br>student activity.</h2></div>
<p class="note" data-en="CTRL is an independent youth initiative currently shaping its identity and building its digital presence. It starts with a simple belief: young people deserve spaces where their voices, questions and ideas matter." data-ar="CTRL مبادرة شبابية مستقلة تعمل حاليًا على بناء هويتها وحضورها الرقمي. تنطلق من إيمان بسيط: الشباب يستحقون مساحات يكون فيها لصوتهم وأسئلتهم وأفكارهم قيمة. ">CTRL is an independent youth initiative currently shaping its identity and building its digital presence. It starts with a simple belief: young people deserve spaces where their voices, questions and ideas matter.</p></div>
<div class="grid">
<article class="tile"><div class="n" data-en="01 — THE SPACE" data-ar="01 — المساحة">01 — THE SPACE</div><h3 data-en="Open conversations" data-ar="حوارات مفتوحة">Open conversations</h3><p data-en="Making room for discussion, curiosity and different points of view." data-ar="مساحة للنقاش والفضول والاستماع إلى وجهات نظر مختلفة.">Making room for discussion, curiosity and different points of view.</p></article>
<article class="tile"><div class="n" data-en="02 — THE APPROACH" data-ar="02 — الأسلوب">02 — THE APPROACH</div><h3 data-en="Unexpected experiences" data-ar="تجارب غير تقليدية">Unexpected experiences</h3><p data-en="Exploring contemporary topics through creative, engaging ways — beyond the usual format." data-ar="نطرح مواضيع معاصرة بطرق إبداعية وتفاعلية تتجاوز الأساليب المعتادة.">Exploring contemporary topics through creative, engaging ways — beyond the usual format.</p></article>
<article class="tile"><div class="n" data-en="03 — THE PURPOSE" data-ar="03 — الهدف">03 — THE PURPOSE</div><h3 data-en="Youth empowerment" data-ar="تمكين الشباب">Youth empowerment</h3><p data-en="Encouraging young people to participate, think critically and turn interest into initiative." data-ar="نشجّع الشباب على المشاركة والتفكير النقدي وتحويل الاهتمام إلى مبادرة.">Encouraging young people to participate, think critically and turn interest into initiative.</p></article>
</div></div></section>

<div class="wrap statement"><p data-en="We believe meaningful change begins when someone makes space for a new perspective." data-ar="نؤمن أن التغيير الحقيقي يبدأ عندما نمنح مساحة لوجهة نظر جديدة.">We believe meaningful change begins when someone makes space for a new perspective.</p><small data-en="THINK DIFFERENTLY. MAKE ROOM. MOVE FORWARD." data-ar="فكّر بشكل مختلف. اصنع مساحة. وانطلق.">THINK DIFFERENTLY. MAKE ROOM. MOVE FORWARD.</small></div>

<section id="vision"><div class="wrap phase">
<div><div class="kicker" data-en="02 / Our direction" data-ar="02 / توجّهنا">02 / Our direction</div><h2 data-en="Built around|people & ideas." data-ar="مساحة تتمحور حول|الناس والأفكار.">Built around<br>people & ideas.</h2></div>
<div class="phase-box"><strong data-en="OUR VISION IN THE MAKING" data-ar="رؤيتنا قيد التشكّل">OUR VISION IN THE MAKING</strong><p data-en="To engage and empower youth through spaces for discussion and contemporary topics, approached in distinctive and creative ways. We are shaping the initiative thoughtfully before its public launch." data-ar="إشراك الشباب وتمكينهم من خلال مساحات للنقاش وطرح مواضيع العصر بأساليب استثنائية وإبداعية. نعمل على بناء المبادرة بعناية قبل انطلاقتها العامة.">To engage and empower youth through spaces for discussion and contemporary topics, approached in distinctive and creative ways. We are shaping the initiative thoughtfully before its public launch.</p></div>
</div></section>

<section id="journey"><div class="wrap">
<div class="section-head"><div><div class="kicker" data-en="03 / The journey" data-ar="03 / رحلتنا">03 / The journey</div><h2 data-en="Currently under|CTRLstruction." data-ar="حاليًا في مرحلة|CTRLstruction.">Currently under<br>CTRLstruction.</h2></div>
<p class="note" data-en="We’re building the foundations first: our identity, our message and the digital space where you’ll be able to discover what CTRL is about. The public launch and activities will come in their time." data-ar="نعمل أولًا على بناء الأساس: هويتنا، ورسالتنا، ومساحتنا الرقمية التي ستتعرّفون من خلالها على CTRL. أما الانطلاقة والأنشطة فستأتي في وقتها.">We’re building the foundations first: our identity, our message and the digital space where you’ll be able to discover what CTRL is about. The public launch and activities will come in their time.</p></div>
<div class="phase-box"><strong data-en="THIS IS THE BEGINNING." data-ar="هذه هي البداية.">THIS IS THE BEGINNING.</strong><p data-en="More about the people, projects and ways to get involved will be shared as CTRL gets ready to launch. For now, consider this our first step into the digital world." data-ar="سنشارك المزيد عن الفريق والمشاريع وفرص المشاركة مع اقتراب انطلاقة CTRL. وحتى ذلك الحين، اعتبروا هذه خطوتنا الأولى في العالم الرقمي.">More about the people, projects and ways to get involved will be shared as CTRL gets ready to launch. For now, consider this our first step into the digital world.</p></div>
</div></section>
</main>
<footer class="wrap"><span data-en="© CTRL — INDEPENDENT YOUTH INITIATIVE" data-ar="© CTRL — مبادرة شبابية مستقلة">© CTRL — INDEPENDENT YOUTH INITIATIVE</span><span data-en="UNDER CTRLSTRUCTION · 2026" data-ar="قيد التشكّل · 2026">UNDER CTRLSTRUCTION · 2026</span></footer>
<script>
document.querySelectorAll('nav a').forEach(a=>a.addEventListener('click',()=>{if(window.innerWidth<=760)document.getElementById('nav').style.display='none'}));
const langToggle=document.getElementById('langToggle');
function setLanguage(lang){
  document.documentElement.lang=lang; document.documentElement.dir=lang==='ar'?'rtl':'ltr';
  document.querySelectorAll('[data-en][data-ar]').forEach(el=>{
    const value=el.dataset[lang];
    if(el.tagName==='H1'||el.tagName==='H2') el.innerHTML=value.replace('|','<br>');
    else el.textContent=value;
  });
  langToggle.textContent=lang==='ar'?'English':'العربية';
  langToggle.setAttribute('aria-label',lang==='ar'?'Switch to English':'التبديل إلى العربية');
  document.title=lang==='ar'?'CTRL — قيد التشكّل':'CTRL — Under CTRLstruction';
}
langToggle.addEventListener('click',()=>setLanguage(document.documentElement.lang==='en'?'ar':'en'));

</script>
</body></html>
